# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=health.s8e.in,backend
DATABASE_URL=postgresql://health-tracker:password@postgres:5432/health-tracker
CORS_ALLOWED_ORIGINS=https://health.s8e.in
SERVICE_API_KEY=change-me-strong-random-key

# MCP Server
DJANGO_API_URL=http://backend:8000/api
# OAuth 2.0 bearer tokens are verified against Authelia's OIDC provider —
# see the separate authelia-stack for the "mcp-server" client registration.
OIDC_ISSUER=https://auth.health.s8e.in
OIDC_CLIENT_ID=mcp-server
OIDC_RESOURCE_URL=https://health.s8e.in/mcp

# Domain
DOMAIN=health.s8e.in
